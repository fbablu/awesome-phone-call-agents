# Copy to .env. Nothing dials unless TETHER_DRY_RUN=false.
TETHER_DRY_RUN=true
TETHER_PORT=8787

# CALL-E (server-side only; never ship this key in the iOS app)
TETHER_CALLE_API_KEY=
# Published Goal id from the CALL-E dashboard. Leave empty to use the one-shot fallback.
TETHER_GOAL_ID=

# Speech-to-text: fixture | gemini | whisper
TETHER_STT=fixture
TETHER_STT_MODEL=gemini-3.8-flash
# Local privacy mode: brew install whisper-cpp, then point at a ggml model file
TETHER_WHISPER_MODEL=

# Triage: fixture | gemini
TETHER_TRIAGE=fixture
TETHER_TRIAGE_MODEL=gemini-3.8-flash
TETHER_GEMINI_API_KEY=
